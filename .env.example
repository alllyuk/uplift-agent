VLLM_DISABLE_CUDA_GRAPH=1
TORCH_CUDA_ARCH_LIST=8.0

#For OpenAI:
LLM_PROVIDER=openai
OPENAI_API_KEY=your-actual-api-key
LLM_MODEL=gpt-5.4-mini

# LLM defaults (used by UI and/or config)
LLM_TEMPERATURE=0.
LLM_BOOTSTRAP_ROUNDS=2
LLM_SAMPLE_ROWS=2500

# Data generation
DATA_SEED=42

# Optional logging settings
LOG_LEVEL=INFO
LOG_ROTATION=10 MB
LOG_RETENTION=1 week
